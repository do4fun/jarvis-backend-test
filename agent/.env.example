# ── LiveKit Cloud ──────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── LLM — Anthropic Claude ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_MODEL=claude-sonnet-4-6

# ── STT — Deepgram ─────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=fr

# ── TTS — Cartesia ─────────────────────────────────────────────────────────────
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_MODEL=sonic-2
CARTESIA_LANGUAGE=fr
# ID voix par défaut (voix française Cartesia)
CARTESIA_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02

# ── SpatialReal Avatar ─────────────────────────────────────────────────────────
SPATIALREAL_API_KEY=your_spatialreal_api_key
SPATIALREAL_APP_ID=your_spatialreal_app_id
SPATIALREAL_AVATAR_ID=your_avatar_id

# ── Personnalité agent (optionnel) ─────────────────────────────────────────────
# AGENT_INSTRUCTIONS=Tu es Jarvis, un assistant personnel...
